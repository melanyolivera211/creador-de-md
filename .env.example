# ==============================================================================
# AGENTE-SCAPPER — CONFIGURACIÓN
# Extractor de Conocimiento Técnico desde Documentación
# ==============================================================================

# Google AI Studio API Key
# Obtenla en: https://aistudio.google.com/
GOOGLE_API_KEY=tu_api_key_aqui

# Modelo Gemini a utilizar (gemini-1.5-flash es rápido y gratuito)
GEMINI_MODEL=gemini-1.5-flash

# Scraping — Límites controlados
MAX_PAGES=30
MAX_DEPTH=3
REQUEST_TIMEOUT=10

# Análisis IA — Mínimo de casos de uso a generar
MIN_USE_CASES=3

# Servidor FastAPI
HOST=127.0.0.1
PORT=8000

# Ruta al directorio raíz de MI-AGENTE (para enviar notas al Knowledge Graph)
MI_AGENTE_PATH=../MI-AGENTE
